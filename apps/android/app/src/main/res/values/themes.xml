<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题 -->
    <style name="Theme.ColonyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主要颜色 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        <!-- 状态栏和导航栏 -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        
        <!-- 窗口背景 -->
        <item name="android:windowBackground">@color/background</item>
        
        <!-- 系统栏亮色图标模式 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Material 3动态颜色 -->
        <item name="android:colorPrimary">@color/seed</item>
        
        <!-- 应用主题配置 -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.ColonyApp.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.ColonyApp.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ColonyApp.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ColonyApp.BodyMedium</item>
    </style>
    
    <!-- 文本样式 -->
    <style name="TextAppearance.ColonyApp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.ColonyApp.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.ColonyApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.ColonyApp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <!-- 深色主题 -->
    <style name="Theme.ColonyApp.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    
    <!-- 启动主题 -->
    <style name="Theme.ColonyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ColonyApp</item>
    </style>
</resources>
