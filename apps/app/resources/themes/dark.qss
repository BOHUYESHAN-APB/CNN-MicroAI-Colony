
/* Dark Theme */
QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}

QStatusBar {
    background-color: #1e1e1e;
    color: #ffffff;
}

QMenuBar {
    background-color: #2b2b2b;
    color: #ffffff;
}

QMenu {
    background-color: #2b2b2b;
    color: #ffffff;
}

QToolBar {
    background-color: #2b2b2b;
    border: none;
}

QLabel {
    color: #ffffff;
}

QPushButton {
    background-color: #3c3c3c;
    color: #ffffff;
    border: 1px solid #505050;
    padding: 5px;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #505050;
}

QPushButton:pressed {
    background-color: #404040;
}
