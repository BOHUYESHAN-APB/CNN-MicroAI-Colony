# Auto detect text files and perform LF normalization
* text=auto
*.ttf filter=lfs diff=lfs merge=lfs -text
app/results/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
app/results/**/*.csv filter=lfs diff=lfs merge=lfs -text
app/results/**/*.json filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
