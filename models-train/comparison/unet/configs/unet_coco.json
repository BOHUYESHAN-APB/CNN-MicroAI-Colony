{
  "model": {
    "name": "unet",
    "n_channels": 3,
    "n_classes": 85,
    "bilinear": true
  },
  "data": {
    "data_dir": "/merged_dataset",
    "img_size": [640, 2048],
    "train_split": "train",
    "val_split": "valid",
    "test_split": "test"
  },
  "train": {
    "epochs": 100,
    "batch_size": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "save_interval": 5
  },
  "output_dir": "./model_output"
}