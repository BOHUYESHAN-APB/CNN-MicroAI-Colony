{
  "name": "colony-analysis-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:ui": "jest --testPathPattern=src/components",
    "test:store": "jest --testPathPattern=src/stores",
    "test:i18n": "jest --testPathPattern=src/i18n",
    "test:cn": "cross-env LANG=zh_CN.UTF-8 ts-node scripts/test-with-report.ts",
    "test:en": "cross-env LANG=en_US.UTF-8 ts-node scripts/test-with-report.ts",
    "test:all": "ts-node scripts/test-with-report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.13.0",
    "@mui/material": "^5.13.0",
    "@tauri-apps/api": "^1.5.0",
    "axios": "^1.6.0",
    "chart.js": "^4.0.0",
    "i18next": "^23.5.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.3.0",
    "react-query": "^3.39.0",
    "react-router-dom": "^6.3.0",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@jest/globals": "^29.7.0",
    "@tauri-apps/cli": "^1.5.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/react-i18next": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^2.0.0",
    "autoprefixer": "^10.4.7",
    "babel-jest": "^29.7.0",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "msw": "^1.3.2",
    "postcss": "^8.4.14",
    "prettier": "^2.8.0",
    "tailwindcss": "^3.1.6",
    "ts-jest": "^29.1.0",
    "ts-jest-mock-import-meta": "^1.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.6.4",
    "vite": "^3.0.0"
  }
}
