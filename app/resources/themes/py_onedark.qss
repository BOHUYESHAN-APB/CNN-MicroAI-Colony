/* PyOneDark Theme for Qt Applications
   Based on One Dark Pro theme for VS Code
*/

/* Main Window */
QMainWindow {
    background-color: #282C34;
    color: #ABB2BF;
}

/* Menus */
QMenuBar {
    background-color: #21252B;
    color: #ABB2BF;
}

QMenuBar::item:selected {
    background-color: #323842;
}

QMenu {
    background-color: #21252B;
    color: #ABB2BF;
    border: 1px solid #181A1F;
}

QMenu::item:selected {
    background-color: #323842;
}

/* Toolbars */
QToolBar {
    background-color: #21252B;
    border: none;
    spacing: 2px;
}

QToolButton {
    background-color: transparent;
    color: #ABB2BF;
    padding: 4px;
    border-radius: 4px;
}

QToolButton:hover {
    background-color: #323842;
}

/* Status Bar */
QStatusBar {
    background-color: #21252B;
    color: #ABB2BF;
}

/* Dock Widgets */
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}

QDockWidget::title {
    background-color: #21252B;
    color: #ABB2BF;
    padding: 6px;
}

/* Scroll Areas */
QScrollArea {
    background-color: #282C34;
    border: none;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #282C34;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4B5363;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5C6370;
}

QScrollBar:horizontal {
    background-color: #282C34;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #4B5363;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5C6370;
}

/* Tables */
QTableView {
    background-color: #282C34;
    color: #ABB2BF;
    gridline-color: #3B4048;
    selection-background-color: #3E4451;
    selection-color: #ABB2BF;
    alternate-background-color: #2C313A;
}

QHeaderView::section {
    background-color: #21252B;
    color: #ABB2BF;
    padding: 4px;
    border: none;
}

/* Buttons */
QPushButton {
    background-color: #3B4048;
    color: #ABB2BF;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #4B5363;
}

QPushButton:pressed {
    background-color: #2C313A;
}

QPushButton:disabled {
    background-color: #282C34;
    color: #5C6370;
}

/* Line Edits */
QLineEdit {
    background-color: #1E2127;
    color: #ABB2BF;
    border: 1px solid #3B4048;
    border-radius: 4px;
    padding: 4px;
}

QLineEdit:focus {
    border: 1px solid #528BFF;
}

/* Combo Boxes */
QComboBox {
    background-color: #1E2127;
    color: #ABB2BF;
    border: 1px solid #3B4048;
    border-radius: 4px;
    padding: 4px;
}

QComboBox:hover {
    border: 1px solid #528BFF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(down_arrow.png);
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #181A1F;
    background-color: #282C34;
}

QTabBar::tab {
    background-color: #21252B;
    color: #ABB2BF;
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #282C34;
    border-bottom: 2px solid #528BFF;
}

QTabBar::tab:hover:!selected {
    background-color: #323842;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #3B4048;
    border-radius: 4px;
    margin-top: 1em;
    color: #ABB2BF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 3px;
}

/* Progress Bars */
QProgressBar {
    border: 1px solid #3B4048;
    border-radius: 4px;
    background-color: #1E2127;
    color: #ABB2BF;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #528BFF;
    width: 1px;
}

/* Labels */
QLabel {
    color: #ABB2BF;
}

/* Tooltips */
QToolTip {
    background-color: #1E2127;
    color: #ABB2BF;
    border: 1px solid #3B4048;
    padding: 4px;
}