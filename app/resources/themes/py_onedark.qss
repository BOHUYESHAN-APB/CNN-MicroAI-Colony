/* Modern Dark Theme */

/* Global Styles */
QMainWindow, QDialog {
    background-color: #282c34;
    color: #abb2bf;
}

QWidget {
    color: #abb2bf;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3e4451;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
    background-color: #21252b;
}

QGroupBox::title {
    color: #61afef;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    background-color: #21252b;
}

/* Buttons */
QPushButton {
    background-color: #3e4451;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #abb2bf;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #4b5363;
}

QPushButton:pressed {
    background-color: #282c34;
}

QPushButton:checked {
    background-color: #61afef;
    color: #282c34;
}

QPushButton:disabled {
    background-color: #282c34;
    color: #5c6370;
}

/* List Widget */
QListWidget {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 4px;
}

QListWidget::item {
    padding: 4px;
    color: #abb2bf;
}

QListWidget::item:selected {
    background-color: #4b5363;
    color: #61afef;
}

QListWidget::item:hover {
    background-color: #3e4451;
}

/* Labels */
QLabel {
    color: #abb2bf;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #3e4451;
    border-radius: 4px;
    text-align: center;
    background-color: #282c34;
}

QProgressBar::chunk {
    background-color: #61afef;
    border-radius: 3px;
}

/* Scroll Bars */
QScrollBar:vertical {
    border: none;
    background: #282c34;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3e4451;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #4b5363;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Horizontal Scroll Bar */
QScrollBar:horizontal {
    border: none;
    background: #282c34;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3e4451;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #4b5363;
}

/* Menu Bar */
QMenuBar {
    background-color: #21252b;
    border-bottom: 1px solid #3e4451;
}

QMenuBar::item {
    padding: 4px 8px;
    background-color: transparent;
    color: #abb2bf;
}

QMenuBar::item:selected {
    background-color: #3e4451;
}

/* Menu */
QMenu {
    background-color: #282c34;
    border: 1px solid #3e4451;
}

QMenu::item {
    padding: 4px 20px;
    color: #abb2bf;
}

QMenu::item:selected {
    background-color: #3e4451;
}

/* Status Bar */
QStatusBar {
    background-color: #21252b;
    color: #abb2bf;
    border-top: 1px solid #3e4451;
}

/* Tool Bar */
QToolBar {
    background-color: #21252b;
    border-bottom: 1px solid #3e4451;
    spacing: 6px;
    padding: 4px;
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 4px;
    padding: 4px;
    color: #abb2bf;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: #3e4451;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #4b5363;
}

/* Slider */
QSlider::groove:horizontal {
    border: 1px solid #3e4451;
    height: 4px;
    background: #282c34;
    margin: 0px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #61afef;
    border: none;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #528bbc;
}

/* Dialog buttons */
QDialogButtonBox {
    button-layout: spread;
}

QMessageBox {
    background-color: #282c34;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 12px;
}
